# Chaufferone backend config. Copy to .env (never commit .env).

# Hosted LLM (Anthropic) for email/WhatsApp extraction and as the voice fallback.
# Bank SMS never needs it: those are parsed by regex on this machine.
ANTHROPIC_API_KEY=

# The labelled switch: false = voice replies parsed by rules only, nothing sent at consent time.
VOICE_LLM_ENABLED=true

# Pin the engine clock so the demo story's dates line up. Remove for real use.
DEMO_TODAY=2026-09-30

# Teammate phone numbers whose SMS are treated like bank SMS during the demo (JSON list).
DEMO_SENDERS=["+919876543210"]

# Who the demo UPI QR pays (a teammate's VPA). Shown masked in the API.
UPI_PAYEE_VPA=teammate@okaxis
UPI_PAYEE_NAME=Demo Teammate

# Optional: Gmail API ingest (testing mode, team accounts as test users)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
